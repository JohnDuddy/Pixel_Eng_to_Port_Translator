# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored so your real key is never committed.

# Required: your OpenAI API key. The key stays server-side and never reaches the app.
OPENAI_API_KEY=your_openai_api_key_here

# Shared secret the Android app sends in the X-Duddy-App-Token header.
# Change this from the default before exposing the backend beyond localhost,
# and set the same value in the app's Settings > App Token.
ALLOWED_APP_TOKEN=dev-local-token

# Optional model overrides (defaults shown).
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-4.1-mini
