# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored so your real key is never committed.

# Required: your OpenAI API key. The key stays server-side and never reaches the app.
OPENAI_API_KEY=your_openai_api_key_here

# Bootstrap secret the Android app sends only to request a short-lived session token.
# Change this from the default before exposing the backend beyond localhost,
# and set the same value in the app's Settings > App Token.
ALLOWED_APP_TOKEN=dev-local-token

# Secret used to sign short-lived backend session tokens. If blank, ALLOWED_APP_TOKEN
# is used as the signing secret for local development.
SESSION_TOKEN_SECRET=replace_with_a_long_random_secret

# Optional model overrides (defaults shown).
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_TEXT_MODEL=gpt-4.1-mini
